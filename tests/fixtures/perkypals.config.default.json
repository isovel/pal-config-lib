{
    // Morph targets driven by the arousal value, in order.
    // One name is driven across the whole 0-1 range. With N names, name i owns
    // the slice [i/N, (i+1)/N] and is driven 0-1 across it, so a staged model
    // can list its stage keys from softest to hardest. Names the mesh does not
    // have are skipped without affecting the others.
    "morphTargets": ["Aroused"],

    // Weight per second while rising. 0.08 is a full climb in ~12s before the
    // per-pal multiplier is applied, so 8-25s across the multiplier range.
    "arousalRate": 0.08,

    // Seconds held at full before decay starts. Unscaled by the per-pal
    // multiplier, so every pal holds for the same time. A gated base worker
    // with SAN above sanity.threshold holds indefinitely.
    "holdDelay": 60.0,

    // Weight per second while falling. 0.10 is a full fall in ~10s, so 7-20s
    // across the multiplier range.
    "decayRate": 0.1,

    // Seconds a pal rests at zero before starting again. Re-rolled every cycle,
    // so pals drift apart over time. This is the single biggest lever on how
    // much is happening at once.
    "onsetDelayMin": 0.0,
    "onsetDelayMax": 30.0,

    // Per-pal speed scale, rolled once per pal. Applies to both rise and fall.
    "rateMultiplierMin": 0.5,
    "rateMultiplierMax": 1.5,
    "player": {
        // The player character, driven alongside the pals off the same morph
        // target names. The activity block reaches it: fighting or working
        // brings it down at once, and anything else - idle, sleeping, riding -
        // runs the cycle and holds at full. SAN is a pal's parameter, so the
        // sanity block never reaches it.
        //
        // Hot-reloads. Turning it off mid-session zeroes the morph and drops the
        // player from the registry within a second; turning it back on picks it up
        // again at a random point in the cycle.
        "enabled": true,

        // The hold at full needs both of these: hunger at or above the
        // ratio AND health at or above the ratio. Below either the player
        // runs the plain timed cycle, and the condition block's own
        // thresholds still bring it down.
        "holdHungerAtLeast": 0.75,
        "holdHealthAtLeast": 0.98
    },
    "debug": {
        // Diagnostics. These hot-reload, so a subsystem can be turned off while
        // the game is running to isolate a fault.
        //
        // Master switch for everything diagnostic: the Alt+P / Alt+I / Alt+O /
        // Alt+L / Alt+U / Alt+K hotkeys, the reflection dump, the per-phase tick
        // timing, and the whole informational log stream. Off here, so a build
        // handed to someone else stays silent and ignores the hotkeys.
        //
        // Warnings and errors always print, on screen and in UE4SS.log.
        "enabled": false,

        // Log each tick phase once a second. The last line before a crash
        // names the subsystem that was running. Requires "enabled" above.
        "trace": false,

        // Functional kill-switches. They work regardless of "enabled", so a
        // suspect subsystem can be shut off in a build that is otherwise silent.
        "enableDriver": true,
        "enableGate": true,
        "enableRegistry": true
    },
    "condition": {
        // Condition rules. Any one of these brings the value down for as long
        // as it holds, at the same rank as fighting or working: hunger below the
        // ratio, health below the ratio, out of stamina, taking damage (any HP
        // drop holds it down for hurtHold seconds, so a single hit registers),
        // draining stamina (same shape, drainHold), and for pals being sick or
        // sitting in the party undeployed; for the player, being too hot or too
        // cold or carrying more than the inventory allows. An undeployed pal
        // starts climbing the moment it is sent out. Hot-reloads.
        "enabled": true,
        "hungerBelow": 0.5,
        "healthBelow": 0.5,

        // Stamina ratio at or below which the character counts as spent.
        "staminaAtMost": 0.0,

        // Player only: inventory weight over its cap, as a ratio of the cap.
        "weightAbove": 1.0,
        "hurtHold": 5.0,

        // Likewise for stamina: anything that drains it - sprinting,
        // climbing, gliding, a pal's attacks - holds the sign negative for
        // this many seconds after each drop.
        "drainHold": 3.0
    },
    "activity": {
        // A pal that is fighting or working comes down regardless of anything
        // else - its SAN, its phase, where it was in the cycle. The one
        // exception is a follower being ridden: carrying the player keeps its
        // normal cycle running.
        //
        // Applies to every pal, base workers included.
        "enabled": true
    },
    "sanity": {
        // Base camp workers only. Below riseThreshold a pal cannot get
        // aroused at all and falls. Between the two it runs the plain timed
        // cycle. Above threshold it stays at full for as long as SAN holds
        // up, ignoring holdDelay. Wild and party pals always run the plain
        // timer cycle.
        "enabled": true,
        "riseThreshold": 0.8,
        "threshold": 0.95
    }
}
